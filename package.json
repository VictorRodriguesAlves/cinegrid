    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "10.10.0",
    "@next/eslint-plugin-next": "16.3.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.70.0",
    "tailwindcss": "4.3.3",
